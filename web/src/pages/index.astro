---
import { Image } from "astro:assets";
import balloon from "../assets/illust/balloon.webp";
import balloons from "../assets/illust/balloons.webp";
import bulb1 from "../assets/illust/bulb-1.webp";
import bulb2 from "../assets/illust/bulb-2.webp";
import bulbGarland from "../assets/illust/bulb-garland.webp";
import cheers from "../assets/illust/cheers.webp";
import garland from "../assets/illust/garland.webp";
import market from "../assets/illust/market.webp";
import talk from "../assets/illust/talk.webp";
import Base from "../layouts/Base.astro";
import { YEAR, hhmm, isoDate, jaDate, list, mediaUrl, pageSlug, titleByReferrer, type MediaValue } from "../lib/cms";

const [notices, exhibitors, slots, sponsors, categories, performers, stages] = await Promise.all([
	list<{ title: string; date: string; pinned?: number }>("notices", YEAR),
	list<{ title: string; catch?: string; booth_number?: string; photos?: { image: MediaValue }[] }>("exhibitors", YEAR),
	list<{ starts_at: string; ends_at: string }>("slots", YEAR),
	list<{ title: string; url?: string; logo?: MediaValue }>("sponsors", YEAR),
	list<{ title: string }>("categories", YEAR),
	list<{ title: string }>("performers", YEAR),
	list<{ title: string }>("stages", YEAR),
]);
notices.sort((a, b) => (b.data.pinned ?? 0) - (a.data.pinned ?? 0) || b.data.date.localeCompare(a.data.date));
exhibitors.sort((a, b) => (a.data.booth_number ?? "").localeCompare(b.data.booth_number ?? "", "ja", { numeric: true }));
slots.sort((a, b) => a.data.starts_at.localeCompare(b.data.starts_at));
const [categoryOf, performerOf, stageOf] = await Promise.all([
	titleByReferrer("categories", categories, "exhibitors_category"),
	titleByReferrer("performers", performers, "slots_performer"),
	titleByReferrer("stages", stages, "slots_stage"),
]);
const scheduleRows = slots.flatMap((s) => {
	const performer = performerOf.get(s.id);
	const stage = stageOf.get(s.id);
	// 出演者かステージが公開されていない出演枠を、時刻だけの行で載せる方法は採らない。誰がどこに出るか分からない行になるため
	if (!performer || !stage) return [];
	return [{ startsAt: new Date(s.data.starts_at), endsAt: new Date(s.data.ends_at), performer, stage }];
});

const logoSponsors = sponsors.filter((s) => s.data.logo);
const nameSponsors = sponsors.filter((s) => !s.data.logo);
---

<Base>
	<main id="main">
		<section class="hero hero--ticket" aria-labelledby="hero-title">
			<div class="blob-field" aria-hidden="true"><div class="blob-field__inner">
				<span class="blob blob--s2 hb-1"></span>
				<span class="blob blob--b blob--s1 hb-2"></span>
				<span class="blob blob--c blob--s3 hb-3"></span>
				<span class="blob blob--s4 blob--extra hb-4"></span>
				<span class="blob blob--c blob--s5 blob--extra hb-5"></span>
				<span class="blob blob--b blob--s3 only-wide hb-6"></span>
				<span class="blob blob--s5 only-wide hb-7"></span>
			</div></div>
			<div class="hero-side" aria-hidden="true">
				<Image class="sway-float hero-side--talk" src={talk} alt="" width={224} densities={[1, 2]} layout="none" loading="lazy" />
				<Image class="sway-hang hero-side--bulb" src={bulb1} alt="" width={80} densities={[1, 2]} layout="none" loading="lazy" />
				<Image class="sway-float hero-side--balloon" src={balloon} alt="" width={96} densities={[1, 2]} layout="none" loading="lazy" />
				<Image class="sway-hang hero-side--garland" src={bulbGarland} alt="" width={224} densities={[1, 2]} layout="none" loading="lazy" />
			</div>

			<div class="container">
				<div class="ticket">
					<div class="ticket__main">
						<Image class="linework bob hero-art--cheers" src={cheers} alt="" width={192} densities={[1, 2]} layout="none" loading="eager" />
						<Image class="linework sway-hang hide-sm hero-art--garland" src={garland} alt="" width={144} densities={[1, 2]} layout="none" loading="eager" />
						<Image class="linework sway-float hero-art--balloons" src={balloons} alt="" width={112} densities={[1, 2]} layout="none" loading="eager" />
						<Image class="linework sway-hang hide-sm hero-art--bulb" src={bulb2} alt="" width={80} densities={[1, 2]} layout="none" loading="eager" />
						<Image class="linework bob hide-sm hero-art--market" src={market} alt="" width={208} densities={[1, 2]} layout="none" loading="eager" />

						<p class="ticket__tagline"><span>まちナかで、</span><span>「すき」を</span><span>進化させていく。</span></p>
						<h1 class="ticket__logo" id="hero-title"><img src="/assets/logo.svg" alt="まちナかぶんかさい" width="490" height="235" /></h1>
						<p class="ticket__sub">夜のマルシェと<br />まちの踊り場</p>
					</div>

					<div class="ticket__stub">
						<p><time datetime="2026-11-14"><span class="ticket__date">11.14<small>sat</small></span></time></p>
						<p class="ticket__time">14:00–19:00</p>
						<p class="ticket__place"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"></path></svg><span>米百俵プレイス</span> <span>ミライエ長岡</span></p>
						<p class="ticket__address">西館と東館の間<br /><span>〒940-0062</span> <span>新潟県長岡市大手通2丁目3-10</span></p>
						<div class="ticket__actions">
							<a class="btn" href="#exhibitors">出展者を見る</a>
							<a class="btn btn--secondary" href="#access">会場へのアクセス</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="news">
			<div class="container">
				<h2 class="section__title">お知らせ</h2>
				{notices.length === 0 ? <p class="section__lead">お知らせはまだありません。</p> : (
					<ul class="news">
						{notices.map((n) => (
							<li>
								<time datetime={isoDate(new Date(n.data.date))}>{jaDate(new Date(n.data.date))}</time>
								<span>{n.data.pinned ? <span class="label">重要</span> : null}</span>
								<a href={`/notices/${pageSlug(n)}/`}>{n.data.title}</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</section>

		<section class="section section--subtle section--wave" id="exhibitors">
			<div class="container">
				<h2 class="section__title">出展者</h2>
				<p class="section__lead">{exhibitors.length === 0 ? "出展者は決まり次第お知らせします。" : `${exhibitors.length}組が出展します。`}</p>
				{exhibitors.length > 0 && <ul class="exhibitors">
					{exhibitors.map((e) => {
						const photo = e.data.photos?.[0]?.image;
						const category = categoryOf.get(e.id);
						return (
							<li class="card card--fun exhibitor">
								{photo ? (
									<Image class="exhibitor__photo" src={mediaUrl(photo)} alt="" width={800} height={600} />
								) : (
									<div class="exhibitor__photo exhibitor__photo--none" aria-hidden="true"></div>
								)}
								<div class="exhibitor__body">
									<span>{category && <span class="label">{category}</span>}</span>
									<h3 class="exhibitor__name"><a href={`/exhibitors/${pageSlug(e)}/`}>{e.data.title}</a></h3>
									{e.data.catch && <p class="exhibitor__catch">{e.data.catch}</p>}
								</div>
							</li>
						);
					})}
				</ul>}
			</div>
		</section>

		<section class="section section--blobbed" id="timetable">
			<div class="container">
				<span class="blob blob--b blob--s1 blob--grow" aria-hidden="true" style="width:min(26rem,70vw);height:min(20rem,56vw);right:-8rem;top:2rem"></span>
				<span class="blob blob--s4 blob--grow blob--extra" aria-hidden="true" style="width:16rem;height:14rem;left:-6rem;bottom:0"></span>
				<h2 class="section__title">スケジュール</h2>
				{scheduleRows.length === 0 ? <p class="section__lead">スケジュールは決まり次第お知らせします。</p> : <div class="table-wrap">
					<table>
						<caption class="sr-only">ステージのスケジュール</caption>
						<thead><tr><th scope="col">時間</th><th scope="col">出演者</th><th scope="col">ステージ</th></tr></thead>
						<tbody>
							{scheduleRows.map((s) => (
								<tr>
									<th scope="row"><time datetime={s.startsAt.toISOString()}>{hhmm(s.startsAt)}</time>–<time datetime={s.endsAt.toISOString()}>{hhmm(s.endsAt)}</time></th>
									<td>{s.performer}</td>
									<td>{s.stage}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>}
			</div>
		</section>

		<section class="section section--subtle section--wave" id="sponsors">
			<div class="container">
				<h2 class="section__title">協賛</h2>
				{sponsors.length === 0 && <p class="section__lead">協賛は決まり次第お知らせします。</p>}
				<div class="sponsors">
					{logoSponsors.length > 0 && (
						<ul class="logo-grid logo-grid--m">
							{logoSponsors.map((s) => {
								const logo = <Image src={mediaUrl(s.data.logo!)} alt={s.data.title} inferSize />;
								return <li>{s.data.url ? <a href={s.data.url}>{logo}</a> : logo}</li>;
							})}
						</ul>
					)}
					{nameSponsors.length > 0 && (
						<ul class="sponsor-names">
							{nameSponsors.map((s) => <li>{s.data.url ? <a href={s.data.url}>{s.data.title}</a> : s.data.title}</li>)}
						</ul>
					)}
				</div>
			</div>
		</section>

		<section class="section" id="access">
			<div class="container">
				<h2 class="section__title">開催情報・アクセス</h2>
				<div class="table-wrap">
					<table>
						<caption class="sr-only">開催情報</caption>
						<tbody>
							<tr><th scope="row">日時</th><td>2026年11月14日（土）14:00〜19:00</td></tr>
							<tr><th scope="row">会場</th><td>米百俵プレイス ミライエ長岡 西館と東館の間（〒940-0062 新潟県長岡市大手通2丁目3-10）<br /><a href="https://maps.google.com/?q=新潟県長岡市大手通2丁目3-10">Google マップで会場を開く</a></td></tr>
							<tr><th scope="row">アクセス</th><td>JR長岡駅 大手口から徒歩5分</td></tr>
							<tr><th scope="row">入場</th><td>無料</td></tr>
							<tr><th scope="row">雨天時</th><td>小雨決行。荒天の場合は前日18時までにお知らせでお伝えします</td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>
	</main>
</Base>
