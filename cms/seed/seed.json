{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"defaultLocale": "ja",
	"meta": {
		"name": "まちナかぶんかさい",
		"description": "まちナかぶんかさいの出展者・出演者・協賛・お知らせ",
		"author": "ゆるまち委員会"
	},
	"settings": {
		"title": "まちナかぶんかさい",
		"tagline": "夜のマルシェとまちの踊り場",
		"timezone": "Asia/Tokyo"
	},
	"collections": [
		{
			"slug": "exhibitors",
			"label": "出展者",
			"labelSingular": "出展者",
			"urlPattern": "/exhibitors/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"sortOrder": 1,
			"admin": { "listColumns": ["year", "booth_number"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
				{ "slug": "title", "label": "名前", "type": "string", "required": true, "searchable": true },
				{ "slug": "category", "label": "出展カテゴリ", "type": "reference", "validation": { "targetCollection": "categories" } },
				{ "slug": "catch", "label": "ひとこと", "type": "string", "searchable": true },
				{
					"slug": "photos",
					"label": "写真（1枚目は一覧にも出る）",
					"type": "repeater",
					"validation": {
						"maxItems": 3,
						"subFields": [{ "slug": "image", "label": "写真", "type": "image", "required": true }]
					}
				},
				{ "slug": "description", "label": "紹介文", "type": "text", "searchable": true },
				{ "slug": "booth_number", "label": "出展場所の番号", "type": "string" },
				{
					"slug": "links",
					"label": "リンク",
					"type": "repeater",
					"validation": {
						"maxItems": 3,
						"subFields": [
							{ "slug": "label", "label": "リンクの名前", "type": "string", "required": true },
							{ "slug": "url", "label": "URL", "type": "url", "required": true }
						]
					}
				},
				{
					"slug": "previous",
					"label": "前回の出展",
					"type": "reference",
					"validation": { "relation": "previous_exhibitor", "relationSide": "child" }
				}
			]
		},
		{
			"slug": "performers",
			"label": "出演者",
			"labelSingular": "出演者",
			"urlPattern": "/performers/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"sortOrder": 2,
			"admin": { "listColumns": ["year"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
				{ "slug": "title", "label": "名前", "type": "string", "required": true, "searchable": true },
				{ "slug": "photo", "label": "写真", "type": "image" },
				{ "slug": "description", "label": "紹介文", "type": "text", "searchable": true },
				{
					"slug": "links",
					"label": "リンク",
					"type": "repeater",
					"validation": {
						"maxItems": 3,
						"subFields": [
							{ "slug": "label", "label": "リンクの名前", "type": "string", "required": true },
							{ "slug": "url", "label": "URL", "type": "url", "required": true }
						]
					}
				},
				{
					"slug": "previous",
					"label": "前回の出展",
					"type": "reference",
					"validation": { "relation": "previous_performer", "relationSide": "child" }
				}
			]
		},
		{
			"slug": "slots",
			"label": "出演時間",
			"labelSingular": "出演時間",
			"routable": false,
			"sortOrder": 3,
			"dateField": "starts_at",
			"admin": { "listColumns": ["year", "starts_at"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
