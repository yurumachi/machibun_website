			"slug": "notices",
			"label": "お知らせ",
			"labelSingular": "お知らせ",
			"urlPattern": "/notices/{slug}",
			"supports": ["drafts", "revisions", "search"],
			"sortOrder": 7,
			"dateField": "date",
			"admin": { "listColumns": ["year", "date", "pinned"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
				{ "slug": "title", "label": "タイトル", "type": "string", "required": true, "searchable": true },
				{ "slug": "date", "label": "日付", "type": "datetime", "required": true, "indexed": true },
				{ "slug": "body", "label": "本文", "type": "portableText", "searchable": true },
				{ "slug": "pinned", "label": "一覧の上に固定する", "type": "boolean", "defaultValue": false }
			]
		},
		{
			"slug": "stages",
			"label": "ステージ",
			"labelSingular": "ステージ",
			"routable": false,
			"group": "イベント設定",
			"sortOrder": 4,
			"admin": { "listColumns": ["year"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
				{ "slug": "title", "label": "名前", "type": "string", "required": true }
			]
		},
		{
			"slug": "categories",
			"label": "出展カテゴリ",
			"labelSingular": "出展カテゴリ",
			"routable": false,
			"group": "イベント設定",
			"sortOrder": 5,
			"admin": { "listColumns": ["year"] },
			"fields": [
				{ "slug": "year", "label": "年", "type": "integer", "required": true, "indexed": true },
				{ "slug": "title", "label": "名前", "type": "string", "required": true }
			]
		}
	],
